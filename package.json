{
  "name": "ai-grievance-triage-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace grievance-triage-api",
    "dev:web": "npm run dev --workspace grievance-triage-web",
    "build:web": "npm run build --workspace grievance-triage-web",
    "start:api": "npm run start --workspace grievance-triage-api"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}